// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every `Json` field below holds a `{ en, fr }` Translation object.
// English is always required; French is required before a record can be
// published. See lib/translations.ts and lib/admin/resource-service.ts.

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique

  // JSON fields - each translation is full markdown text
  title       Json
  description Json

  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique

  title       Json
  description Json
  location    Json
  category    Json

  date        DateTime
  time        String?
  imageUrl    String?

  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Announcement {
  id          String   @id @default(cuid())

  title       Json
  description Json
  fullContent Json

  date        DateTime
  priority    String   @default("medium") // low | medium | high
  imageUrl    String?

  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Workshop {
  id              String   @id @default(cuid())
  slug            String   @unique

  title           Json
  description     Json
  fullDescription Json
  location        Json
  duration        Json
  capacity        Json

  date            DateTime
  images          String[]

  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

model CharityProgram {
  id            String    @id @default(cuid())
  slug          String    @unique

  title           Json
  description     Json
  fullDescription Json
  impact          Json
  beneficiaries   Json
  location        Json

  date          DateTime?
  amountUsed    String?
  totalGoal     String?
  images        String[]

  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A CEPCA member church. Each one can be handed a login that may edit this
/// record and nothing else — see lib/auth/roles.ts.
model MemberChurch {
  id           String   @id @default(cuid())
  slug         String   @unique

  denomination Json
  leader       Json
  location     Json
  history      Json

  founded      String?
  logo         String?
  images       String[]

  phone        String?
  email        String?
  address      String?
  website      String?

  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sermon {
  id          String   @id @default(cuid())

  title       Json
  description Json
  location    Json

  date        DateTime
  duration    String?
  videoUrl    String?
  audioUrl    String?
  thumbnail   String?

  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}
/// A dashboard login. Replaces the previous third-party auth provider: the
/// council now owns its own accounts.
///
/// `role` mirrors AppRole in lib/auth/roles.ts — `super_admin` (the council
/// secretariat) or `church` (one member church). A `church` row carries the
/// MemberChurch id it may edit; the session is the ONLY place that id is read
/// from, never the request body.
model User {
  id           String    @id @default(cuid())
  /// Always stored lowercased — the login form lowercases before it looks up.
  email        String    @unique
  /// bcrypt hash, cost 12. Plaintext is never stored or logged.
  passwordHash String
  name         String?
  /// "super_admin" | "church"
  role         String    @default("church")
  /// Set only for `church` accounts — the MemberChurch they may edit.
  churchId     String?

  /// Set when the secretariat issues a temporary password, cleared on the
  /// first successful password change. Shown as a nudge in the dashboard.
  mustChangePassword Boolean @default(false)

  sessions     Session[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([churchId])
}

/// Server-side half of a login. The cookie only carries this row's id (signed
/// with SESSION_SECRET), so deleting the row logs the person out everywhere
/// and role changes take effect on the next request.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
